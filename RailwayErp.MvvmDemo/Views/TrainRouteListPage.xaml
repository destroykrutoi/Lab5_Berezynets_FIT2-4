<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RailwayErp.MvvmDemo.ViewModels"
             xmlns:m="clr-namespace:RailwayErp.MvvmDemo.Models"
             x:Class="RailwayErp.MvvmDemo.Views.TrainRouteListPage"
             x:DataType="vm:TrainRouteListViewModel"
             Title="Маршрути">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout VerticalOptions="Center">
                <Label AutomationId="NetworkLabel" Text="{Binding NetworkText}" FontAttributes="Bold" />
                <Label AutomationId="QueueLabel" Text="{Binding QueueCount, StringFormat='У черзі синхронізації: {0}'}" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="Офлайн" VerticalOptions="Center" />
            <Switch Grid.Column="2" AutomationId="OfflineSwitch" IsToggled="{Binding IsOffline}" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button AutomationId="AddRouteButton" Text="Додати маршрут" Command="{Binding AddCommand}" />
            <Button Grid.Column="1" AutomationId="SyncButton" Text="Синхронізувати" Command="{Binding SyncCommand}" />
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <VerticalStackLayout>
                <Label AutomationId="SyncMessage" Text="{Binding SyncMessage}" TextColor="Gray" />
                <Label Text="У базі даних поки немає маршрутів" TextColor="Gray" IsVisible="{Binding IsEmpty}" />
            </VerticalStackLayout>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Routes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:TrainRoute">
                        <Border Margin="0,4" Padding="12" StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#505050}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Route}" />
                                    <Label Text="{Binding DepartureTime, StringFormat='Відправлення: {0:HH:mm}'}" />
                                    <Label Text="{Binding ChiefDocumentNumber, StringFormat='Документ начальника поїзда: {0}'}" TextColor="Gray" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="Змінити"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainRouteListViewModel}}, Path=EditCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Видалити"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainRouteListViewModel}}, Path=DeleteCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
